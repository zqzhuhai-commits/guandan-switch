CXX ?= g++
CXXFLAGS += -std=c++17 -O2 -Wall
SDL_CFLAGS := $(shell pkg-config --cflags sdl2 SDL2_ttf)
SDL_LIBS := $(shell pkg-config --libs sdl2 SDL2_ttf)
guandan-desktop: source/main.cpp source/engine.hpp source/hand_layout.hpp source/table_ui.hpp source/storage.hpp source/audio_engine.hpp source/voice_cues.hpp source/stb_image.h
	$(CXX) $(CXXFLAGS) $(SDL_CFLAGS) source/main.cpp $(SDL_LIBS) -o $@
.PHONY: test test-ui clean
test:
	$(CXX) -std=c++17 -O2 tests/rules.cpp -o rules-test
	./rules-test
	$(CXX) -std=c++17 -O2 tests/hand_layout.cpp -o hand-layout-test
	./hand-layout-test
	$(CXX) -std=c++17 -O2 tests/storage.cpp -o storage-test
	./storage-test
test-ui: guandan-desktop
	$(CXX) $(CXXFLAGS) $(SDL_CFLAGS) tests/ui.cpp $(SDL_LIBS) -o ui-test
	SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy ./ui-test
	$(CXX) $(CXXFLAGS) $(SDL_CFLAGS) tests/audio.cpp $(SDL_LIBS) -o audio-test
	SDL_AUDIODRIVER=dummy ./audio-test
	python3 tools/verify_runtime.py
clean:
	rm -f guandan-desktop rules-test ui-test hand-layout-test storage-test audio-test
